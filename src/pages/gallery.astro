---
import Base from '../layouts/Base.astro';

const imgs = ['meka-01','meka-02','meka-03','meka-04','meka-05','meka-06','scene-peaks','scene-forest','scene-storm','scene-island','scene-nebula','scene-canyon'];
const lineages = ['Cryo', 'Nomad', 'Relay', 'Scavenger'];
const names = ['Boreal', 'Ashfall', 'Vega', 'Cinder', 'Halcyon', 'Drift', 'Quill', 'Marrow', 'Ember', 'Static', 'Onyx', 'Pallor'];

const items = imgs.map((img, i) => ({
  img: `/img/${img}.jpg`,
  id: String(2100 + i * 37),
  name: names[i % names.length],
  lineage: lineages[i % lineages.length],
  price: (1.8 + (i % 5) * 0.42).toFixed(2),
  rarity: ['Common', 'Rare', 'Epic', 'Mythic'][i % 4],
}));
---

<Base title="MekaVerse — Gallery" active="Gallery" description="Browse the MekaVerse genesis collection — ten thousand monochrome rendered artifacts.">
  <section class="ghero">
    <div class="ghero__inner">
      <div class="caption ghero__kick reveal">THE COLLECTION — 10,000 ARTIFACTS</div>
      <h1 class="display ghero__title reveal" data-delay="1">
        <span class="mark-line" style="--mark-w:40%;">The</span>
        <span class="mark-line" style="--mark-w:58%;">Gallery</span>
      </h1>
      <p class="mono-12 ghero__sub reveal" data-delay="2">Every frame hangs in the void. Hover to bring one to light.</p>
    </div>
  </section>

  <div class="gtoolbar" id="gtoolbar">
    <div class="filters" role="tablist" aria-label="Filter by lineage">
      <button class="chip is-on mono-12" data-filter="all" role="tab" aria-selected="true">All</button>
      {lineages.map((l) => (
        <button class="chip mono-12" data-filter={l} role="tab" aria-selected="false">{l}</button>
      ))}
    </div>
    <div class="gcount caption" id="gcount">{items.length} SHOWN</div>
  </div>

  <section class="grid" id="grid">
    {items.map((it, i) => (
      <article class="card reveal" data-lineage={it.lineage} data-delay={String((i % 4) + 1)}>
        <div class="card__frame">
          <img src={it.img} alt={`Meka #${it.id} — ${it.name}`} loading="lazy" width="600" height="600" />
          <span class="card__rarity caption">{it.rarity}</span>
        </div>
        <div class="card__body">
          <div class="card__row">
            <span class="mono-12 card__name">{it.name}</span>
            <span class="mono-12 card__id">#{it.id}</span>
          </div>
          <div class="card__row card__row--sub">
            <span class="caption card__lin">{it.lineage} LINEAGE</span>
            <span class="caption card__price">{it.price} ETH</span>
          </div>
        </div>
        <button class="card__buy mono-10" data-buy={it.name}>ACQUIRE →</button>
      </article>
    ))}
  </section>

  <section class="gfoot">
    <button class="btn" id="loadMore">Load More Artifacts</button>
    <p class="caption gfoot__note">SHOWING A CURATED SLICE OF THE 10,000</p>
  </section>

  <style>
    .ghero { padding: 140px 60px 40px; }
    .ghero__inner { max-width: 900px; }
    .ghero__kick { color: var(--color-ash); margin-bottom: 22px; }
    .ghero__title { color: var(--color-bone); }
    .ghero__sub { color: var(--color-ash); margin-top: 20px; }

    .gtoolbar {
      position: sticky; top: 56px; z-index: 40;
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 60px;
      background: rgba(0,0,0,0.7); backdrop-filter: blur(12px);
      border-top: 1px solid var(--frost-10);
      border-bottom: 1px solid var(--frost-10);
    }
    .filters { display: flex; gap: 8px; flex-wrap: wrap; }
    .chip {
      color: var(--color-ash);
      border: 1px solid var(--frost-20);
      border-radius: var(--radius-sm);
      padding: 8px 14px;
      transition: color .3s, border-color .3s, background .3s;
    }
    .chip:hover { color: var(--color-bone); border-color: var(--frost-30); }
    .chip.is-on { color: var(--color-void); background: var(--color-bone); border-color: var(--color-bone); }
    .gcount { color: var(--color-ash); }

    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      padding: 40px 60px 20px;
    }
    .card { display: flex; flex-direction: column; }
    .card.is-hidden { display: none; }
    .card__frame {
      position: relative;
      aspect-ratio: 1 / 1;
      border: 1px solid var(--frost-10);
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: #060606;
    }
    .card__frame img {
      width: 100%; height: 100%; object-fit: cover;
      filter: grayscale(1) contrast(1.05) brightness(0.82);
      transform: scale(1.02);
      transition: filter .6s ease, transform .8s cubic-bezier(0.16,1,0.3,1);
    }
    .card:hover .card__frame img { filter: grayscale(0) contrast(1.05) brightness(1); transform: scale(1.06); }
    .card__rarity {
      position: absolute; top: 10px; left: 10px;
      color: var(--color-bone);
      background: rgba(0,0,0,0.55);
      border: 1px solid var(--frost-20);
      border-radius: var(--radius-sm);
      padding: 5px 8px;
      backdrop-filter: blur(4px);
    }
    .card__body { padding: 14px 4px 4px; }
    .card__row { display: flex; justify-content: space-between; align-items: baseline; }
    .card__name { color: var(--color-bone); }
    .card__id { color: var(--color-ash); }
    .card__row--sub { margin-top: 7px; }
    .card__lin, .card__price { color: var(--color-ash); }
    .card__buy {
      margin-top: 12px;
      text-align: left;
      color: var(--color-ash);
      border-top: 1px solid var(--frost-10);
      padding-top: 12px;
      letter-spacing: 0.04em;
      transition: color .3s;
      align-self: stretch;
    }
    .card__buy:hover { color: var(--color-bone); }

    .gfoot { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 40px 60px 100px; }
    .gfoot__note { color: var(--color-ash); }

    @media (max-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 780px) {
      .ghero { padding: 120px 24px 30px; }
      .ghero__title { font-size: 52px; }
      .gtoolbar { padding: 14px 24px; flex-direction: column; gap: 12px; align-items: flex-start; }
      .grid { grid-template-columns: repeat(2, 1fr); gap: 14px; padding: 30px 24px 20px; }
      .gfoot { padding: 30px 24px 80px; }
    }
    @media (max-width: 460px) { .grid { grid-template-columns: 1fr; } }
  </style>

  <script is:inline>
    (function () {
      const chips = document.querySelectorAll('.chip');
      const cards = Array.from(document.querySelectorAll('.card'));
      const count = document.getElementById('gcount');
      chips.forEach((chip) =>
        chip.addEventListener('click', () => {
          chips.forEach((c) => { c.classList.remove('is-on'); c.setAttribute('aria-selected', 'false'); });
          chip.classList.add('is-on'); chip.setAttribute('aria-selected', 'true');
          const f = chip.getAttribute('data-filter');
          let shown = 0;
          cards.forEach((card) => {
            const match = f === 'all' || card.getAttribute('data-lineage') === f;
            card.classList.toggle('is-hidden', !match);
            if (match) shown++;
          });
          count.textContent = shown + ' SHOWN';
        })
      );
      document.querySelectorAll('[data-buy]').forEach((b) =>
        b.addEventListener('click', () => window.mekaToast && window.mekaToast('Reserved · ' + b.getAttribute('data-buy') + ' added to cart'))
      );
      document.getElementById('loadMore')?.addEventListener('click', () =>
        window.mekaToast && window.mekaToast('The full 10,000 unlock at mint')
      );
    })();
  </script>
</Base>
