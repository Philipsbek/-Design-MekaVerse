---
import Base from '../layouts/Base.astro';

const tiers = [
  { name: 'Single', qty: 1, note: 'One artifact, one lineage. The purest way in.' },
  { name: 'Pair', qty: 2, note: 'Two frames — draw from two lineages at once.' },
  { name: 'Squad', qty: 3, note: 'Max per wallet. The full monochrome set.' },
];
const price = 0.08;
---

<Base title="MekaVerse — Mint" active="Shop" description="Mint your genesis Meka. 0.08 ETH, max 3 per wallet, monochrome forever.">
  <section class="mint" data-parallax>
    <div class="mint__art" style="--bg:url('/img/scene-nebula.jpg')" data-parallax-layer></div>

    <div class="mint__grid">
      <!-- left: pitch -->
      <div class="mint__left">
        <div class="caption reveal mint__kick">GENESIS MINT — LIVE NOW</div>
        <h1 class="display reveal mint__title" data-delay="1">
          <span class="mark-line" style="--mark-w:40%;">Mint your</span>
          <span class="mark-line" style="--mark-w:32%;">Meka.</span>
        </h1>
        <p class="mono-12 reveal mint__body" data-delay="2">
          Ten thousand rendered artifacts, revealed on mint. Each one hand-lit against the void.
          0.08 ETH per frame · maximum three per wallet · no roadmap, only the work.
        </p>
        <div class="mint__meters reveal" data-delay="3">
          <div class="meter">
            <div class="meter__row caption"><span>MINTED</span><span id="mintedLabel">6,402 / 10,000</span></div>
            <div class="meter__bar"><span class="meter__fill" style="--pct:64%"></span></div>
          </div>
          <div class="mint__facts">
            <div class="fact"><span class="fact__v display" data-count="0.08">0.08</span><span class="fact__k caption">ETH / FRAME</span></div>
            <div class="fact"><span class="fact__v display" data-count="3">3</span><span class="fact__k caption">MAX / WALLET</span></div>
            <div class="fact"><span class="fact__v display" data-count="10000">10,000</span><span class="fact__k caption">SUPPLY</span></div>
          </div>
        </div>
      </div>

      <!-- right: mint panel -->
      <div class="mint__panel reveal" data-delay="2">
        <div class="panel__head">
          <span class="caption">MINT / SEASON 02</span>
          <span class="caption panel__live"><span class="livedot"></span>LIVE</span>
        </div>

        <div class="panel__preview" id="preview">
          <img src="/img/meka-01.jpg" alt="Meka preview" id="previewImg" width="600" height="600" />
          <div class="panel__scan"></div>
          <span class="caption panel__previewtag">UNREVEALED</span>
        </div>

        <div class="tiers" role="radiogroup" aria-label="Quantity">
          {tiers.map((t, i) => (
            <button class:list={['tier', { 'is-on': i === 0 }]} data-qty={String(t.qty)} role="radio" aria-checked={i === 0 ? 'true' : 'false'}>
              <span class="mono-12 tier__name">{t.name}</span>
              <span class="caption tier__qty">×{t.qty}</span>
            </button>
          ))}
        </div>
        <p class="caption tier__note" id="tierNote">{tiers[0].note}</p>

        <div class="qty">
          <button class="qty__btn mono-12" id="qtyMinus" aria-label="Decrease">−</button>
          <div class="qty__val"><span id="qtyVal">1</span><span class="caption">FRAMES</span></div>
          <button class="qty__btn mono-12" id="qtyPlus" aria-label="Increase">+</button>
        </div>

        <div class="total">
          <span class="caption">TOTAL</span>
          <span class="mono-12 total__v"><span id="totalVal">0.08</span> ETH</span>
        </div>

        <button class="btn mint__btn" id="mintBtn">
          <span class="dot" aria-hidden="true"></span><span id="mintLabel">Connect to Mint</span>
        </button>
        <p class="caption mint__fine">GAS ESTIMATED AT CHECKOUT · MONOCHROME FOREVER</p>
      </div>
    </div>
  </section>

  <!-- roadmap-lite / faq strip -->
  <section class="faq">
    <div class="faq__head">
      <div class="caption reveal">DETAILS</div>
      <h2 class="display reveal faq__title" data-delay="1">
        <span class="mark-line" style="--mark-w:50%;">Before you</span>
        <span class="mark-line" style="--mark-w:30%;">mint.</span>
      </h2>
    </div>
    <div class="faq__list">
      {[
        { q: 'What am I actually minting?', a: 'A genesis MekaVerse artifact — a unique rendered frame revealed 24 hours after mint closes. Metadata is stored permanently.' },
        { q: 'Why is everything black?', a: 'The gallery is intentionally monochrome. The only color in MekaVerse is the light each artifact carries. The shell disappears so the work can glow.' },
        { q: 'How many can I mint?', a: 'Three per wallet, maximum. No allowlist tricks, no tiered pricing — 0.08 ETH per frame for everyone.' },
        { q: 'Is this real?', a: 'This is a design demonstration of the MekaVerse portal shell. Nothing is signed and no wallet is charged.' },
      ].map((f, i) => (
        <details class="qa reveal" data-delay={String((i % 4) + 1)}>
          <summary class="qa__q"><span class="mono-12">{f.q}</span><span class="qa__mark">+</span></summary>
          <p class="qa__a mono-12">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <style>
    .mint { position: relative; min-height: 100vh; overflow: hidden; isolation: isolate; display: flex; align-items: center; padding: 110px 60px 70px; }
    .mint__art { position: absolute; inset: -8% 0; z-index: -2; background-image: var(--bg); background-size: cover; background-position: center; will-change: transform; }
    .mint::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to right, rgba(0,0,0,0.92) 30%, rgba(0,0,0,0.55) 100%), linear-gradient(to top, rgba(0,0,0,0.7), transparent 60%); }

    .mint__grid { width: 100%; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 60px; align-items: center; }
    .mint__kick { color: var(--color-ash); margin-bottom: 22px; }
    .mint__title { color: var(--color-bone); margin-bottom: 26px; }
    .mint__body { color: var(--color-ash); line-height: 1.6; max-width: 460px; margin-bottom: 34px; }

    .mint__meters { max-width: 480px; }
    .meter__row { display: flex; justify-content: space-between; color: var(--color-ash); margin-bottom: 10px; }
    .meter__bar { height: 3px; background: var(--frost-20); border-radius: 2px; overflow: hidden; }
    .meter__fill { display: block; height: 100%; width: 0; background: var(--color-bone); border-radius: 2px; transition: width 1.6s cubic-bezier(0.16,1,0.3,1); transition-delay: 0.3s; }
    .reveal.is-in .meter__fill { width: var(--pct); }
    .mint__facts { display: flex; gap: 40px; margin-top: 34px; }
    .fact__v { font-size: 34px; color: var(--color-bone); display: block; line-height: 1; }
    .fact__k { color: var(--color-ash); display: block; margin-top: 10px; }

    /* panel */
    .mint__panel {
      background: rgba(0,0,0,0.5);
      border: 1px solid var(--frost-20);
      border-radius: var(--radius-2xl);
      padding: 20px;
      backdrop-filter: blur(14px);
    }
    .panel__head { display: flex; justify-content: space-between; align-items: center; color: var(--color-ash); margin-bottom: 16px; }
    .panel__live { display: flex; align-items: center; gap: 6px; color: var(--color-bone); }
    .livedot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-bone); animation: pulse-dot 1.8s ease-in-out infinite; }

    .panel__preview { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--frost-10); }
    .panel__preview img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(0.7) contrast(1.1); }
    .panel__scan { position: absolute; inset: 0; background: linear-gradient(to bottom, transparent, rgba(255,255,255,0.06), transparent); background-size: 100% 40%; background-repeat: no-repeat; animation: scan 3.4s ease-in-out infinite; }
    @keyframes scan { 0% { background-position: 0 -40%; } 100% { background-position: 0 140%; } }
    .panel__previewtag { position: absolute; bottom: 10px; left: 10px; color: var(--color-bone); background: rgba(0,0,0,0.55); border: 1px solid var(--frost-20); border-radius: 2px; padding: 5px 8px; }

    .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 18px; }
    .tier { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; border: 1px solid var(--frost-20); border-radius: var(--radius-sm); padding: 12px; transition: border-color .3s, background .3s; }
    .tier__name { color: var(--color-bone); }
    .tier__qty { color: var(--color-ash); }
    .tier:hover { border-color: var(--frost-30); }
    .tier.is-on { background: var(--color-charcoal); border-color: var(--color-frost); }
    .tier__note { color: var(--color-ash); margin-top: 12px; min-height: 12px; }

    .qty { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; border: 1px solid var(--frost-20); border-radius: var(--radius-sm); }
    .qty__btn { color: var(--color-bone); padding: 14px 22px; font-size: 16px; transition: background .3s; }
    .qty__btn:hover { background: rgba(255,255,255,0.05); }
    .qty__val { display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .qty__val span:first-child { font-size: 20px; font-family: var(--font-gt-america-mono); }
    .qty__val .caption { color: var(--color-ash); }

    .total { display: flex; justify-content: space-between; align-items: center; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--frost-10); }
    .total .caption { color: var(--color-ash); }
    .total__v { color: var(--color-bone); font-size: 15px; }

    .mint__btn { width: 100%; justify-content: center; margin-top: 18px; padding: 15px; }
    .mint__fine { color: var(--color-ash); opacity: 0.6; text-align: center; margin-top: 12px; }

    /* faq */
    .faq { padding: 120px 60px; border-top: 1px solid var(--frost-10); }
    .faq__head { margin-bottom: 50px; }
    .faq__title { color: var(--color-bone); margin-top: 20px; }
    .faq__list { max-width: 860px; }
    .qa { border-top: 1px solid var(--frost-10); }
    .qa:last-child { border-bottom: 1px solid var(--frost-10); }
    .qa__q { display: flex; justify-content: space-between; align-items: center; padding: 24px 0; cursor: pointer; color: var(--color-bone); list-style: none; }
    .qa__q::-webkit-details-marker { display: none; }
    .qa__mark { color: var(--color-ash); font-family: var(--font-gt-america-mono); transition: transform .3s ease; }
    .qa[open] .qa__mark { transform: rotate(45deg); }
    .qa__a { color: var(--color-ash); line-height: 1.6; padding: 0 40px 24px 0; max-width: 60ch; }

    @media (max-width: 980px) {
      .mint { padding: 100px 24px 60px; }
      .mint__grid { grid-template-columns: 1fr; gap: 40px; }
      .mint__title { font-size: 54px; }
      .mint__facts { gap: 26px; }
      .faq { padding: 80px 24px; }
    }
  </style>

  <script is:inline>
    (function () {
      const PRICE = 0.08;
      const MAX = 3;
      const previews = ['/img/meka-01.jpg','/img/meka-02.jpg','/img/meka-03.jpg','/img/meka-04.jpg','/img/meka-05.jpg','/img/meka-06.jpg'];
      const notes = {
        1: 'One artifact, one lineage. The purest way in.',
        2: 'Two frames — draw from two lineages at once.',
        3: 'Max per wallet. The full monochrome set.',
      };
      let qty = 1;

      const qtyVal = document.getElementById('qtyVal');
      const totalVal = document.getElementById('totalVal');
      const tierNote = document.getElementById('tierNote');
      const previewImg = document.getElementById('previewImg');
      const tiers = document.querySelectorAll('.tier');

      function render() {
        qtyVal.textContent = qty;
        totalVal.textContent = (qty * PRICE).toFixed(2);
        tiers.forEach((t) => {
          const on = Number(t.getAttribute('data-qty')) === qty;
          t.classList.toggle('is-on', on);
          t.setAttribute('aria-checked', String(on));
        });
        if (notes[qty]) tierNote.textContent = notes[qty];
        previewImg.src = previews[(qty - 1) % previews.length];
      }
      function setQty(n) { qty = Math.max(1, Math.min(MAX, n)); render(); }

      tiers.forEach((t) => t.addEventListener('click', () => setQty(Number(t.getAttribute('data-qty')))));
      document.getElementById('qtyPlus').addEventListener('click', () => setQty(qty + 1));
      document.getElementById('qtyMinus').addEventListener('click', () => setQty(qty - 1));

      // cycle preview for effect
      let pv = 0;
      setInterval(() => { if (qty === 1) { pv = (pv + 1) % previews.length; previewImg.src = previews[pv]; } }, 2800);

      document.getElementById('mintBtn').addEventListener('click', () => {
        window.mekaToast && window.mekaToast('Simulated mint · ' + qty + ' frame' + (qty > 1 ? 's' : '') + ' · ' + (qty * PRICE).toFixed(2) + ' ETH');
      });
      render();
    })();
  </script>
</Base>
